# Copy to .env and fill in as needed. Never commit the real .env file.

# LLM provider: fake | ollama | openai
TRIAGEAI_LLM_PROVIDER=ollama

# Ollama (default local provider — no key required)
TRIAGEAI_OLLAMA_MODEL=llama3.1:8b
TRIAGEAI_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (optional cloud provider)
TRIAGEAI_OPENAI_MODEL=gpt-4o-mini
TRIAGEAI_OPENAI_API_KEY=

# Vector store
TRIAGEAI_CHROMA_PERSIST_DIR=./data/chroma
TRIAGEAI_CHROMA_COLLECTION=knowledge_docs

# Graph memory (Neo4j — wired in Phase 3; in-memory stand-in until then)
TRIAGEAI_NEO4J_URI=bolt://localhost:7687
TRIAGEAI_NEO4J_USER=neo4j
TRIAGEAI_NEO4J_PASSWORD=
TRIAGEAI_USE_IN_MEMORY_GRAPH=true

# Routing
TRIAGEAI_CONFIDENCE_THRESHOLD=0.75

# Observability
TRIAGEAI_LOG_LEVEL=INFO
TRIAGEAI_SERVICE_NAME=triageai
